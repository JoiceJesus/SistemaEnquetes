<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,model.OpcaoRespostaModel" %>
<% List<OpcaoRespostaModel> opcoes=(List<OpcaoRespostaModel>)request.getAttribute("opcoes"); String idEnquete=request.getParameter("idEnquete"); %>
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><title>Opções</title><link rel="stylesheet" href="assets/css/style.css"></head><body class="bg-gray-100 p-8"><div class="max-w-xl mx-auto bg-white rounded-xl shadow p-6"><h1 class="text-2xl font-bold mb-4">Opções de resposta</h1><form method="post" action="opcao" class="flex gap-2 mb-5"><input type="hidden" name="idEnquete" value="<%=idEnquete%>"><input class="flex-1 border rounded p-2" name="descricaoOpcao" required placeholder="Nova opção"><button class="bg-indigo-600 text-white px-4 py-2 rounded">Adicionar</button></form><ul class="space-y-2"><% if(opcoes!=null) for(OpcaoRespostaModel o:opcoes){ %><li class="border rounded p-3 flex justify-between"><span><%=o.getDescricaoOpcao()%></span><a class="text-red-600" href="opcao?acao=excluir&id=<%=o.getIdOpcao()%>&idEnquete=<%=idEnquete%>" onclick="return confirm('Excluir?')">Excluir</a></li><% } %></ul><div class="mt-5"><a class="text-indigo-600" href="enquete?acao=listar">← Voltar</a></div></div></body></html>