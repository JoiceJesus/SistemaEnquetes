<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,model.UsuarioModel,model.NivelAcessoModel" %>
<% List<UsuarioModel> usuarios=(List<UsuarioModel>)request.getAttribute("usuarios"); UsuarioModel editando=(UsuarioModel)request.getAttribute("usuario"); List<NivelAcessoModel> niveis=(List<NivelAcessoModel>)request.getAttribute("niveis"); %>
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Usuários</title><script src="https://cdn.tailwindcss.com"></script></head><body class="bg-gray-100 p-6"><div class="max-w-6xl mx-auto">
<div class="flex justify-between mb-5"><h1 class="text-2xl font-bold">Gerenciamento de Usuários</h1><a class="text-indigo-600" href="<%=request.getContextPath()%>/dashboard">← Dashboard</a></div>
<% if(editando!=null){ %><form method="post" action="<%=request.getContextPath()%>/usuario" class="bg-white rounded-xl shadow p-5 mb-6 grid md:grid-cols-2 gap-4"><input type="hidden" name="acao" value="atualizar"><input type="hidden" name="idUsuario" value="<%=editando.getIdUsuario()%>"><div><label class="text-sm">Nome</label><input class="w-full border rounded p-2" name="nome" required value="<%=editando.getNome()%>"></div><div><label class="text-sm">E-mail</label><input class="w-full border rounded p-2" type="email" name="email" required value="<%=editando.getEmail()%>"></div><div><label class="text-sm">Nova senha (deixe vazio para manter)</label><input class="w-full border rounded p-2" type="password" name="senha"></div><div><label class="text-sm">Perfil</label><select class="w-full border rounded p-2" name="idNivel"><% for(NivelAcessoModel n:niveis){ %><option value="<%=n.getIdNivelAcesso()%>" <%=editando.getNivelAcesso().getIdNivelAcesso()==n.getIdNivelAcesso()?"selected":""%>><%=n.getTipo()%></option><% } %></select></div><div><label class="text-sm">Status</label><select class="w-full border rounded p-2" name="status"><option value="1" <%=editando.getStatus()==1?"selected":""%>>Ativo</option><option value="0" <%=editando.getStatus()==0?"selected":""%>>Inativo</option></select></div><div class="flex items-end"><button class="bg-indigo-600 text-white px-4 py-2 rounded">Salvar alterações</button><a class="ml-3 text-gray-600" href="<%=request.getContextPath()%>/usuario?acao=listar">Cancelar</a></div></form><% } %>
<div class="bg-white rounded-xl shadow overflow-x-auto"><table class="w-full text-sm"><thead class="bg-gray-50"><tr><th class="text-left p-3">ID</th><th class="text-left p-3">Nome</th><th class="text-left p-3">E-mail</th><th class="text-left p-3">Perfil</th><th class="text-left p-3">Status</th><th class="text-left p-3">Ações</th></tr></thead><tbody><% if(usuarios!=null) for(UsuarioModel u:usuarios){ %><tr class="border-t"><td class="p-3"><%=u.getIdUsuario()%></td><td class="p-3"><%=u.getNome()%></td><td class="p-3"><%=u.getEmail()%></td><td class="p-3"><%=u.getNivelAcesso().getTipo()%></td><td class="p-3"><%=u.getStatus()==1?"Ativo":"Inativo"%></td><td class="p-3"><a class="text-indigo-600 mr-3" href="<%=request.getContextPath()%>/usuario?acao=editar&id=<%=u.getIdUsuario()%>">Editar</a><a class="text-red-600" href="<%=request.getContextPath()%>/usuario?acao=excluir&id=<%=u.getIdUsuario()%>" onclick="return confirm('A exclusão falhará se este usuário tiver votos/enquetes vinculados. Continuar?')">Excluir</a></td></tr><% } %></tbody></table></div></div></body></html>
